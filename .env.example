# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Кому слать утренний дайджест (свой chat_id; узнать командой /whoami)
TELEGRAM_OWNER_CHAT_ID=123456789

# --- Провайдер LLM ---
# gemini | groq | openrouter | mistral | anthropic | openai | ollama
FITCOACH_PROVIDER=gemini

# Ключ: либо общий FITCOACH_API_KEY, либо родная переменная провайдера ниже.
FITCOACH_API_KEY=
GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# Необязательно: переопределить модель и адрес (для своего или локального сервера)
# FITCOACH_MODEL=gemini-2.5-flash
# FITCOACH_BASE_URL=http://localhost:11434/v1

# --- Прочее ---
FITCOACH_DB_PATH=data/fitcoach.db
FITCOACH_TIMEZONE=Europe/Moscow
FITCOACH_MORNING_TIME=07:30
FITCOACH_WEEKLY_DAY=sun
FITCOACH_WEEKLY_TIME=19:00
