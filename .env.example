# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Кому слать утренний дайджест (свой chat_id; узнать командой /whoami)
TELEGRAM_OWNER_CHAT_ID=123456789

# --- Провайдер LLM ---
# gemini | groq | openrouter | mistral | anthropic | openai | ollama
FITCOACH_PROVIDER=ollama

# Локальной Ollama ключ не нужен. Для облачных — общий FITCOACH_API_KEY
# или родная переменная провайдера.
FITCOACH_API_KEY=
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# Модель и адрес. Для Ollama по умолчанию gemma3:12b на localhost.
# FITCOACH_MODEL=gemma3:12b
# FITCOACH_BASE_URL=http://localhost:11434/v1

# Чтение скриншотов: auto (по модели) | on | off
FITCOACH_VISION=auto
# Таймаут запроса к модели, сек. Локальной модели на CPU нужно много.
FITCOACH_TIMEOUT=600

# --- Прочее ---
FITCOACH_DB_PATH=data/fitcoach.db
FITCOACH_TIMEZONE=Europe/Moscow
FITCOACH_MORNING_TIME=07:30
FITCOACH_WEEKLY_DAY=sun
FITCOACH_WEEKLY_TIME=19:00
